# ==========================================
# CryptoSignalScanner - نمونه فایل تنظیمات
# این فایل را کپی کن و نامش را به .env تغییر بده، سپس مقادیر واقعی را وارد کن.
# هرگز فایل .env واقعی را در گیت‌هاب یا هیچ‌جای عمومی قرار نده.
# ==========================================

# --- Secrets (اجباری) ---
GEMINI_API_KEY=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Market ---
SYMBOLS=BTCUSDT,ETHUSDT,SOLUSDT
TIMEFRAME=5m
HTF_TIMEFRAME_1=15m
HTF_TIMEFRAME_2=1h
CANDLE_LIMIT=200
TOOBIT_BASE_URL=https://api.toobit.com

# --- Scheduler ---
ANALYSIS_INTERVAL=300

# --- Signal thresholds ---
MIN_CONFIDENCE=70
MIN_RISK_REWARD=1.5

# --- Gemini ---
GEMINI_MODEL=gemini-2.0-flash
GEMINI_TIMEOUT=30

# --- Safety ---
# در ابتدا حتماً true بگذار تا هیچ پیامی واقعی به تلگرام ارسال نشود
DRY_RUN=true
